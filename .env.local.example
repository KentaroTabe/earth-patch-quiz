# Cloudflare R2 へアップロードするための設定の雛形。
#
#   cp .env.local.example .env.local
#   （.env.local を開いて値を入れる）
#   npm run fetch -- --force
#
# .env.local は .gitignore に入っているのでコミットされない。
# 秘密情報はこのファイル（.env.local.example）には絶対に書かないこと。

# アカウントID（Cloudflare ダッシュボードの R2 の画面、または
# S3 API のエンドポイント https://<ここ>.r2.cloudflarestorage.com に出ている）
R2_ACCOUNT_ID=

# バケット名
R2_BUCKET=

# R2 の API トークンから作られるアクセスキー。
# 権限は「オブジェクトの読み書き」だけで足りる。管理者権限は要らない。
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 公開URL。config/pipeline.json の r2.publicBase を上書きしたいときだけ書く。
# 通常は空でよい。
# R2_PUBLIC_BASE=
